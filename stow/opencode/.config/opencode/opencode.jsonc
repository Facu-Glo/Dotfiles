{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "plan",
  "agent": {
    "plan": {
      "color": "#34d399"
    },
    "build": {
      "permission": {
        "bash": {
          "git add *": "deny",
          "git commit *": "deny",
          "git push *": "deny",
          "git *": "allow",
          "grep *": "allow",
          "*": "ask"
        }
      },
      "color": "#c099ff"
    }
  }
}
